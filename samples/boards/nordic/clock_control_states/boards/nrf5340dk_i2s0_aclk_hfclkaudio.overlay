/*
 * Case: nRF5340, i2s0 as the consumer, audio clock sourced from the HFXO-backed audio PLL.
 *
 * i2s0 is only used to carry the clock state; the sample does not operate the I2S. The
 * aclk_hfclkaudio state names the audio-clock signal and the hfclkaudio producer
 * (nordic,nrf-clock-hfclkaudio), which the sample requests through the clock control API. The
 * signal frequency defaults to the SoC value; override &aclk (and, once the driver is aligned,
 * the producer rate) here to pick a different audio frequency.
 */
/ {
	aliases {
		clk-consumer = &i2s0;
	};
};

&i2s0 {
	clocks = <&aclk_hfclkaudio>;
};
