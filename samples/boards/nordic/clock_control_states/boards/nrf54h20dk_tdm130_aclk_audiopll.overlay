/*
 * Case: nRF54H20, tdm130 as the consumer, SCK/MCK on the audio clock (ACLK) from the audiopll.
 *
 * tdm130 is only used to carry the clock state; the sample does not operate the TDM. The single
 * aclk_audiopll state applies to both SCK and MCK: it maps to the ACLK mux position and names the
 * audiopll producer, which the TDM driver requests. The base frequency comes from the audiopll's
 * clock-frequency (its audio rate in Hz).
 */
/ {
	aliases {
		clk-consumer = &tdm130;
	};
};

&pinctrl {
	tdm130_default_alt: tdm130_default_alt {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 3)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 6)>,
				<NRF_PSEL(TDM_SDOUT, 1, 4)>,
				<NRF_PSEL(TDM_SDIN, 1, 5)>,
				<NRF_PSEL(TDM_MCK, 1, 7)>;
		};
	};
};

&audiopll {
	status = "okay";
};

&tdm130 {
	status = "okay";
	pinctrl-0 = <&tdm130_default_alt>;
	pinctrl-names = "default";
	memory-regions = <&cpuapp_dma_region>;
	mck-frequency = <11289600>;
	clocks = <&aclk_audiopll>;
};
