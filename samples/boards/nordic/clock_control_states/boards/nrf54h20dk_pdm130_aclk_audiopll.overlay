/*
 * Case: nRF54H20, pdm130 (pdm0) as the consumer, base clock on the audio clock (ACLK) from the
 * audiopll.
 *
 * pdm0 is only used to carry the clock state; the sample does not operate the PDM. The
 * aclk_audiopll state maps to the ACLK mux position and names the audiopll producer, which the PDM
 * driver requests. The base frequency comes from the audiopll's clock-frequency (its audio rate in
 * Hz).
 */
/ {
	aliases {
		clk-consumer = &pdm0;
	};
};

&pinctrl {
	pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 7)>,
				<NRF_PSEL(PDM_DIN, 1, 8)>;
		};
	};
};

&audiopll {
	status = "okay";
};

&pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
	memory-regions = <&cpuapp_dma_region>;
	clocks = <&aclk_audiopll>;
};
