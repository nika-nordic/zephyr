/*
 * Case: nRF54H20, pdm130 (pdm0) as the consumer, base clock on the 16 MHz peripheral clock (PCLK)
 * with fll16m driven from the HFXO for crystal accuracy.
 *
 * pdm0 is only used to carry the clock state; the sample does not operate the PDM. The
 * pclk16m_hfxo state maps to the PCLK mux position and names the fll16m producer, requested so it
 * locks to the HFXO.
 */
/ {
	aliases {
		clk-consumer = &pdm0;
	};
};

&pinctrl {
	pdm0_default_alt: pdm0_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 7)>,
				<NRF_PSEL(PDM_DIN, 1, 8)>;
		};
	};
};

&fll16m {
	status = "okay";
};

&hfxo {
	status = "okay";
};

&pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default_alt>;
	pinctrl-names = "default";
	memory-regions = <&cpuapp_dma_region>;
	clocks = <&pclk16m_hfxo>;
};
