/* Clock states (nordic,clock-state) of the nRF7120 clocks. Each state is a pure descriptor
 * selected by a consumer's `clocks` property; it is /omit-if-no-ref/ so it costs nothing until
 * referenced. Included at the end of the SoC devicetree, after the referenced signals and
 * producers.
 */

/ {
	clock-states {
		/* Audio clock. The aclk signal advertises the target audio frequency; the audiopll
		 * producer (the AUXPLL, aliased audiopll for uniformity with nRF54H20) is requested
		 * and driven to that rate from PCLK32M. A single state, always PLL-backed.
		 */
		/omit-if-no-ref/ aclk_audiopll: aclk-audiopll {
			compatible = "nordic,clock-state";
			#clock-cells = <0>;
			clock-output = <&aclk>;
			clock-producer = <&audiopll>;
		};
	};
};
